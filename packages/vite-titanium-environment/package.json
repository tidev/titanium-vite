{
  "name": "@titanium-sdk/vite-titanium-environment",
  "version": "1.0.0-alpha.1",
  "description": "Custom Vite environment for building Titanium apps.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo node_modules",
    "dev": "tsc",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "keywords": [],
  "author": "TiDev, Inc. <npm@tidev.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tidev/titanium-vite.git",
    "directory": "packages/vite-titanium-environment"
  },
  "homepage": "https://github.com/tidev/titanium-vite#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!**/*.spec.*"
  ],
  "peerDependencies": {
    "vite": "^8.0.11"
  },
  "devDependencies": {
    "@titanium-sdk/eslint-config": "workspace:*",
    "@titanium-sdk/prettier-config": "workspace:*",
    "@titanium-sdk/tsconfig": "workspace:*",
    "@types/debug": "^4.1.12",
    "@types/node": "catalog:",
    "dotenv-cli": "^7.4.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@titanium-sdk/eslint-config/base"
    ]
  },
  "prettier": "@titanium-sdk/prettier-config"
}
